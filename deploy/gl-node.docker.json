{
    "ledgerPath": "/data/ledger.bean",
    "ledgersDir": "/data/ledgers",
    "port": 4000,
    "bindAddress": "0.0.0.0",
    "graphiql": false,
    "cors": {
        "allowedOrigins": []
    },
    "allowedHosts": [
        "localhost"
    ],
    "auth": {
        "enabled": true,
        "apiKey": ""
    },
    "signing": {
        "enabled": true
    },
    "tls": {
        "mode": "terminated"
    },
    "p2p": {
        "enabled": true,
        "secretKeyPath": "/data/identity.secret",
        "bootstrapEndpointIds": [],
        "gossipIntervalMilliseconds": 1000,
        "antiEntropyIntervalMilliseconds": 5000,
        "swarmTopic": "openledger/docker-dev",
        "meshId": "openledger/docker-dev",
        "relayMode": "disabled"
    }
}
